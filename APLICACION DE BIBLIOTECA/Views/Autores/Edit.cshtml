@model APLICACION_DE_BIBLIOTECA.Models.Autor

@{
    ViewData["Title"] = "Editar Autor";
}

<h1>Editar Autor</h1>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="ID" />

    <div class="mb-3">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Apellido" class="form-label"></label>
        <input asp-for="Apellido" class="form-control" />
        <span asp-validation-for="Apellido" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Nacionalidad" class="form-label"></label>
        <input asp-for="Nacionalidad" class="form-control" />
        <span asp-validation-for="Nacionalidad" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Fecha_De_Nacimiento" class="form-label"></label>
        <input asp-for="Fecha_De_Nacimiento" type="date" class="form-control" />
        <span asp-validation-for="Fecha_De_Nacimiento" class="text-danger"></span>
    </div>

    <div class="mb-3 form-check">
        <input asp-for="Activo" class="form-check-input" type="checkbox" />
        <label asp-for="Activo" class="form-check-label">Autor Activo</label>
    </div>

    <button type="submit" class="btn btn-warning">Guardar Cambios</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>