@model IEnumerable<APLICACION_DE_BIBLIOTECA.Models.Autor>

@{
    ViewData["Title"] = "Listado de Autores";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Listado de Autores</h2>
            <p class="text-muted mb-0 small">Hay @Model.Count() autores registrados</p>
        </div>
        @if (User.IsInRole("Administrador") || User.IsInRole("Bibliotecario"))
        {
            <a class="btn btn-primary shadow-sm px-3" asp-action="Create">Nuevo Autor</a>
        }
        
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var autor in Model)
        {
            <div class="col">
                <div class="card h-100 border-0 shadow-sm rounded-3">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="bg-light rounded-circle d-flex align-items-center justify-content-center border" style="width: 50px; height: 50px;">
                                <span class="fw-bold text-secondary">@autor.Nombre.Substring(0, 1)</span>
                            </div>
                            <div>
                                <h5 class="fw-bold text-dark mb-0">@autor.Nombre</h5>
                                <span class="text-muted small">@autor.Nacionalidad</span>
                            </div>
                        </div>

                        <p class="text-muted small mb-2">
                            <strong>Fecha Nacimiento:</strong> @autor.Fecha_De_Nacimiento.ToString("dd/MM/yyyy")
                        </p>

                        <div class="mt-auto">
                            <div class="mb-3">
                                @if (autor.Activo)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">No activo</span>
                                }
                            </div>
                            <div class="d-flex gap-1">
                                <a asp-action="Details" asp-route-id="@autor.ID" class="btn btn-light btn-sm flex-fill border text-secondary fw-semibold">Ver</a>
                                @if (User.IsInRole("Administrador") || User.IsInRole("Bibliotecario"))
                                {
                                    <a asp-action="Edit" asp-route-id="@autor.ID" class="btn btn-outline-warning btn-sm flex-fill fw-semibold">Editar</a>
                                }
                                @if (User.IsInRole("Administrador"))
                                {
                                    <a asp-action="Delete" asp-route-id="@autor.ID" class="btn btn-outline-danger btn-sm flex-fill fw-semibold">Eliminar</a>
                                }

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>