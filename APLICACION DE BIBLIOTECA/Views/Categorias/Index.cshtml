@model IEnumerable<APLICACION_DE_BIBLIOTECA.Models.Categoria>
@{
    ViewData["Title"] = "Categorías";
}

<div class="container py-4">
    
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Listado de Categorías De Libros</h2>
            <p class="text-muted mb-0 small">Gestion de Generos de Categorias de Libros</p>
        </div>
        <a class="btn btn-primary shadow-sm px-3" asp-controller="Categorias" asp-action="Create">
             Agregar Categoría
        </a>
    </div>

    
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="px-4 py-3">ID</th>
                            <th class="py-3">Nombre</th>
                            <th class="py-3">Descripción</th>
                            <th class="text-end px-4 py-3">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int contador = 1;
                        }

                        <tbody>
                            @foreach (var categoria in Model)
                            {
                                <tr>
                                    
                                    <td class="px-4 fw-bold text-secondary">
                                        @contador
                                    </td>

                                    <td class="fw-bold text-dark">@categoria.Nombre</td>
                                    <td class="text-muted small">
                                        @(string.IsNullOrEmpty(categoria.Descripcion) ? "Sin descripción" : categoria.Descripcion)
                                    </td>
                                    <td class="text-end px-4">
                                        
                                        <a asp-action="Edit" asp-route-id="@categoria.ID" class="btn btn-outline-warning btn-sm me-1 fw-semibold">Editar</a>
                                        <a asp-action="Delete" asp-route-id="@categoria.ID" class="btn btn-outline-danger btn-sm fw-semibold">Eliminar</a>
                                    </td>
                                </tr>

                                contador++; 
                            }
                        </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var mensaje = '@Html.Raw(TempData["SuccessMessage"])';
        if (mensaje) {
            Swal.fire({
                icon: 'success',
                title: 'Éxito',
                text: mensaje,
                timer: 3000,
                showConfirmButton: false
            });
        }
    </script>
}