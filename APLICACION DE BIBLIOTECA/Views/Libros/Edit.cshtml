@model APLICACION_DE_BIBLIOTECA.Models.Libro

@{
    ViewData["Title"] = "Editar Libro";
}

<!-- Envolvemos todo en una tarjeta (card) con sombra para mejor UI -->
<div class="card shadow-sm mt-4">
    <div class="card-body">
        <h2 class="card-title mb-4">@ViewData["Title"]</h2>

        <div class="row">
            <div class="col-md-8">
                <!-- Se agrega la clase swal-save-form para mantener consistencia -->
                <form asp-action="Edit" method="post" enctype="multipart/form-data" class="swal-save-form">
                    <input type="hidden" asp-for="ID" />

                    <div class="mb-3">
                        <label asp-for="Titulo" class="form-label fw-bold">Título</label>
                        <input asp-for="Titulo" class="form-control" required />
                        <!-- Span para mostrar errores de validación -->
                        <span asp-validation-for="Titulo" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Autor" class="form-label fw-bold">Autor</label>
                        <input asp-for="Autor" class="form-control" required />
                        <span asp-validation-for="Autor" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Categoria" class="form-label fw-bold">Categoría</label>
                            <input asp-for="Categoria" class="form-control" required />
                            <span asp-validation-for="Categoria" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Precio" class="form-label fw-bold">Precio</label>
                            <input asp-for="Precio" type="number" step="0.01" class="form-control" required />
                            <span asp-validation-for="Precio" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- Cambiado a form-switch para que se vea como un interruptor moderno -->
                    <div class="mb-3 form-check form-switch mt-3">
                        <input asp-for="Disponible" class="form-check-input" type="checkbox" />
                        <label asp-for="Disponible" class="form-check-label fw-bold">Disponible para préstamo</label>
                    </div>

                    <div class="mb-4 mt-3">
                        <label class="form-label fw-bold">Cambiar Imagen (Opcional)</label>
                        <input type="file" name="imagenFile" class="form-control" accept="image/*" />
                    </div>

                    <div class="mt-4">
                        <!-- Botón verde (btn-success) como en la vista de Autores -->
                        <button type="submit" class="btn btn-success">Guardar Cambios</button>
                        <a asp-action="Index" class="btn btn-outline-secondary ms-2">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Scripts necesarios para que las validaciones funcionen sin recargar la página -->
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}