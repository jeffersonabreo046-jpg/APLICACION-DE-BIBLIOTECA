@model List<APLICACION_DE_BIBLIOTECA.Models.Libro>
@{
    ViewData["Title"] = "Listado de Libros";
}

<h2 class="mb-3">Listado de Libros</h2>
<p class="text-muted">Hay @Model.Count() libros registrados.</p>

<a asp-action="Create" class="btn btn-primary mb-4">Nuevo Libro +</a>

<div class="row">
    @foreach (var libro in Model)
    {
        <div class="col-md-6 mb-4">
            <div class="card h-100 shadow-sm border-secondary border-opacity-25">
                <div class="card-body">
                    <div class="d-flex gap-3 align-items-start">
                        @if (!string.IsNullOrEmpty(libro.ImagenUrl))
                        {
                            <img src="@libro.ImagenUrl" alt="@libro.Titulo" style="width: 70px; height: 95px; object-fit: cover;" class="rounded border shadow-sm" />
                        }
                        else
                        {
                            <div class="bg-light text-secondary d-flex align-items-center justify-content-center rounded border shadow-sm fw-bold" style="width: 70px; height: 95px; font-size: 10px; text-align: center;">
                                Sin Foto
                            </div>
                        }
                        <div class="flex-grow-1">
                            <h5 class="card-title fw-bold mb-1">@libro.Titulo</h5>
                            <p class="card-text mb-1 text-secondary"><strong>Autor:</strong> @libro.Autor</p>
                            <p class="card-text mb-1 text-secondary"><strong>Categoría:</strong> @libro.Categoria</p>
                            <p class="card-text mb-2 text-secondary">
                                <small><strong>Precio:</strong> $@libro.Precio.ToString("0.00")</small>
                            </p>
                            <p class="card-text mb-3">
                                <span class="badge @(libro.Disponible ? "bg-success" : "bg-danger")">
                                    @(libro.Disponible ? "Disponible" : "Prestado")
                                </span>
                            </p>
                            <div class="d-flex gap-2">
                                <a asp-action="Details" asp-route-id="@libro.ID" class="btn btn-sm btn-info text-white">Ver</a>
                                <a asp-action="Edit" asp-route-id="@libro.ID" class="btn btn-sm btn-warning">Editar</a>
                                <a asp-action="Delete" asp-route-id="@libro.ID" class="btn btn-sm btn-danger">Eliminar</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        }