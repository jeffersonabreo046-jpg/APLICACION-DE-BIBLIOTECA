@model IEnumerable<APLICACION_DE_BIBLIOTECA.Models.Libro>
@{
    ViewData["Title"] = "Listado de Libros";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Listado de Libros</h2>
            <p class="text-muted mb-0 small">Hay @Model.Count() libros registrados en el catalogo</p>
        </div>

        @*botpn de agregar a Administrador y Bibliotecario *@
        @if (User.IsInRole("Administrador") || User.IsInRole("Bibliotecario"))
        {
            <a class="btn btn-primary shadow-sm px-3" asp-action="Create">Nuevo Libro +</a>
        }
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var libro in Model)
        {
            <div class="col">
                <div class="card h-100 border-0 shadow-sm rounded-3">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex gap-3 mb-3">
                            <img src="@(string.IsNullOrEmpty(libro.ImagenUrl) ? "/images/no-cover.png" : libro.ImagenUrl)"
                                 alt="@libro.Titulo"
                                 class="rounded border object-fit-cover"
                                 style="width: 80px; height: 110px;" />
                            <div>
                                <h5 class="fw-bold text-dark mb-1">@libro.Titulo</h5>
                                <p class="text-muted small mb-1"><strong>Autor:</strong> @libro.Autor</p>
                                <p class="text-muted small mb-1"><strong>Categoría:</strong> @libro.Categoria</p>
                                <p class="fw-bold text-success mb-0">$@libro.Precio.ToString("0.00")</p>
                            </div>
                        </div>

                        <div class="mt-auto">
                            <div class="mb-3">
                                @if (libro.Disponible)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Disponible</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">Prestado</span>
                                }
                            </div>

                            @*opciones de editar y eliminar a Administrador y Bibliotecario *@
                            @if (User.IsInRole("Administrador") || User.IsInRole("Bibliotecario"))
                            {
                                <div class="d-flex gap-1">
                                    <a asp-action="Edit" asp-route-id="@libro.ID" class="btn btn-outline-warning btn-sm flex-fill fw-semibold">Editar</a>

                                    <form asp-action="Delete" asp-route-id="@libro.ID" method="post" class="swal-delete-form flex-fill m-0 p-0" style="display:inline;">
                                        <button type="submit" class="btn btn-outline-danger btn-sm w-100 fw-semibold">Eliminar</button>
                                    </form>
                                </div>
                            }
                            else
                            {
                                @*Usuarios normales solo verán el botón de Ver Detalles*@
                                <div class="d-flex gap-1">
                                    <a asp-action="Details" asp-route-id="@libro.ID" class="btn btn-outline-info btn-sm w-100 fw-semibold">Ver Detalles</a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>